# Public base URL of the BHORKIT API, including the /api/v1 prefix.
#
# NEXT_PUBLIC_ means this is INLINED INTO THE BUNDLE AT BUILD TIME. It must be
# set before `next build` runs — exporting it only in the runtime environment
# has no effect, and changing it needs a rebuild rather than a restart.
#
# Required in production: the build fails with a clear message if it is unset,
# rather than shipping a site that quietly calls localhost. Optional in
# development, where it defaults to http://localhost:5000/api/v1.
#
# Read by both the API client and the /admin route guard, from one shared
# constant, so the two can never point at different hosts.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Name of the session cookie the /admin guard looks for. Must match COOKIE_NAME
# in the backend's .env.
NEXT_PUBLIC_SESSION_COOKIE=bhorkit_session

# Canonical site URL, used for SEO metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
